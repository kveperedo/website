{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_PREVIEW_BUILD=true cf dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm run cf:generate && tsc --noEmit",
    "build": "cf build",
    "preview:vite": "vite preview",
    "deploy": "cf deploy",
    "preview:deploy": "cf previews deploy",
    "preview:delete": "cf workers delete",
    "cf:generate": "cf workers types",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "checks": "concurrently -n lint,format,test,typecheck \"pnpm:lint\" \"pnpm:format:check\" \"pnpm:test\" \"pnpm:typecheck\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:check": "prisma validate",
    "prepare": "husky"
  },
