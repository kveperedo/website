generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/generated/zod"
}

datasource db {
  provider = "postgresql"
}

enum TransactionCategory {
  food_drinks
  groceries_household
  transportation
  bills_utilities
  health_wellness
  hobbies_lifestyle
  financial

  @@map("transaction_categories")
}

enum TransactionType {
  expense
  income

  @@map("transaction_types")
}

model ScheduledTransactionTemplate {
  id                  String               @id @default(uuid()) @db.Uuid
  description         String
  amount              Decimal              @db.Decimal(10, 2)
  type                TransactionType      @default(expense)
  category            TransactionCategory?
  dayOfMonth          Int                  @map("day_of_month")
  startDate           DateTime             @map("start_date") @db.Date
  endDate             DateTime?            @map("end_date") @db.Date
  maxOccurrences      Int?                 @map("max_occurrences")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  transactions        Transaction[]        @relation("ScheduledTransaction")

  @@index([isActive])
  @@map("scheduled_transaction_templates")
}

model Transaction {
  id                      String                        @id @default(uuid()) @db.Uuid
  description             String
  amount                  Decimal                       @db.Decimal(10, 2)
  type                    TransactionType               @default(expense)
  category                TransactionCategory?
  transactedAt            DateTime                      @map("transacted_at") @db.Timestamptz(6)
  templateId              String?                       @map("template_id") @db.Uuid
  template                ScheduledTransactionTemplate? @relation("ScheduledTransaction", fields: [templateId], references: [id], onDelete: SetNull)
  createdAt               DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([templateId, transactedAt])
  @@index([transactedAt])
  @@index([templateId])
  @@map("transactions")
}
