# Required for session signing. Use a long random secret.
SESSION_SECRET=

# Required for admin login. Store a bcrypt hash of the password.
ADMIN_PASSWORD_HASH=

# Direct PostgreSQL URL used only by Prisma CLI commands (migrations, Studio, generation).
DATABASE_URL=

# Direct PostgreSQL URL used by the local Hyperdrive binding when running `npm run dev`.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Base URL for the E2E/Playwright test run.
BASE_URL=http://localhost:3000

# Plaintext admin password used by local E2E tests to log in.
# Must match the password behind ADMIN_PASSWORD_HASH.
E2E_PASSWORD=

OPENAI_API_KEY=
